# Вариант исходного Dockerfile для Railway: Railway не поддерживает инструкцию VOLUME
# (том подключается средствами платформы), плюс воспроизводимая установка по lock-файлу.
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY . .
ENV NODE_ENV=production PORT=3000 DATA_DIR=/data
EXPOSE 3000
CMD ["node", "server.js"]
